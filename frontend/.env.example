## Local dev: leave as-is, Vite's dev server proxies /api to localhost:5000 (see vite.config.js).
## Vercel/production: set this to the full deployed backend URL, e.g.
##   VITE_API_BASE_URL=https://your-backend.vercel.app/api/v1
## This is baked in at BUILD time, so set it in Vercel's Environment Variables
## before deploying, not after.
VITE_API_BASE_URL=/api/v1
