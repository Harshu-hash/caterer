NODE_ENV=development
PORT=5000

MONGODB_URI=mongodb://127.0.0.1:27017/caterer

JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
COOKIE_NAME=caterer_token

CLIENT_ORIGIN=http://localhost:5173

# STORAGE_PROVIDER=local stores images on disk under backend/uploads.
# STORAGE_PROVIDER=cloudinary requires the three CLOUDINARY_* values below.
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
NOTIFY_TO_EMAIL=
